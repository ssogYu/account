generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ==============================
// 枚举
// ==============================

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

/// 账单类型：支出 或 收入
enum BillType {
  expense
  income
}

/// 分类适用类型
enum CategoryType {
  expense
  income
  both
}

/// 家庭组角色
enum FamilyRole {
  owner
  member
}

// ==============================
// 用户
// ==============================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  username     String     @unique @db.VarChar(50)
  passwordHash String     @db.VarChar(255)
  avatar       String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @db.Timestamptz
  lastLogoutAt  DateTime?  @db.Timestamptz
  createdAt     DateTime   @default(now()) @db.Timestamptz
  updatedAt    DateTime   @updatedAt @db.Timestamptz

  bills           Bill[]
  billAttachments BillAttachment[]
  categories      Category[]
  conversations   Conversation[]
  paymentAccounts PaymentAccount[]
  ownedFamilies   Family[]       @relation("familyOwner")
  familyMember    FamilyMember?

  @@index([email])
  @@index([username])
  @@map("users")
}

// ==============================
// 分类
// ==============================

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @db.Uuid
  familyId  String?      @db.Uuid
  name      String       @db.VarChar(50)
  icon      String?      @db.VarChar(50)
  type      CategoryType
  isSystem  Boolean      @default(false)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now()) @db.Timestamptz

  user      User?        @relation(fields: [userId], references: [id])
  family    Family?      @relation(fields: [familyId], references: [id])
  bills     Bill[]

  @@unique([userId, familyId, name])
  @@map("categories")
}

// ==============================
// 支付账户
// ==============================

model PaymentAccount {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  familyId  String?  @db.Uuid
  name      String   @db.VarChar(50)
  icon      String?  @db.VarChar(50)
  balance   Decimal? @db.Decimal(12, 2)
  isSystem  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  user      User?    @relation(fields: [userId], references: [id])
  family    Family?  @relation(fields: [familyId], references: [id])
  bills     Bill[]

  @@unique([userId, familyId, name])
  @@map("payment_accounts")
}

// ==============================
// 账单
// ==============================

model Bill {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  familyId         String?         @db.Uuid
  amount           Decimal         @db.Decimal(12, 2)
  type             BillType
  categoryId       String          @db.Uuid
  paymentAccountId String?         @db.Uuid
  note             String?         @db.VarChar(200)
  billDate         DateTime        @db.Timestamptz
  createdAt        DateTime        @default(now()) @db.Timestamptz
  updatedAt        DateTime        @updatedAt @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id])
  family           Family?         @relation(fields: [familyId], references: [id])
  category         Category        @relation(fields: [categoryId], references: [id])
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  attachments      BillAttachment[]

  @@index([userId, billDate(sort: Desc)])
  @@index([familyId, billDate(sort: Desc)])
  @@map("bills")
}

// ==============================
// 账单图片附件（用于跨会话图片指纹去重）
// ==============================

model BillAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  contentHash String   @db.VarChar(64)
  objectName  String   @db.VarChar(255)
  url         String   @db.VarChar(500)
  billId      String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill Bill? @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@unique([userId, contentHash])
  @@index([billId])
  @@map("bill_attachments")
}

// ==============================
// AI 对话记录
// ==============================

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String?   @db.VarChar(100)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           String       @db.VarChar(20)
  content        String       @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ==============================
// 家庭组
// ==============================

/// 家庭组，加入后成员共享分类、支付账户和账单
model Family {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(50)
  inviteCode String   @unique @db.VarChar(8)
  ownerId    String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  owner            User             @relation("familyOwner", fields: [ownerId], references: [id])
  members          FamilyMember[]
  bills            Bill[]
  categories       Category[]
  paymentAccounts  PaymentAccount[]

  @@map("families")
}

/// 家庭成员关系（一个用户只能加入一个家庭）
model FamilyMember {
  id       String     @id @default(uuid()) @db.Uuid
  familyId String     @db.Uuid
  userId   String     @unique @db.Uuid
  role     FamilyRole
  joinedAt DateTime   @default(now()) @db.Timestamptz

  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("family_members")
}
